# ---------------------------------------------------------------------------
# Money Machine — copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

APP_NAME=Money Machine
ENVIRONMENT=development
LOG_LEVEL=INFO

# 127.0.0.1 = local only. Use 0.0.0.0 only behind a firewall / HTTPS reverse proxy.
HOST=127.0.0.1
PORT=8000

# Used only by docker-compose.prod.yml + deploy/Caddyfile; ignored by the app.
# Set to your public subdomain for automatic HTTPS, e.g. bot.example.com.
DOMAIN=

# Dashboard HTTP Basic Auth. Set a strong password before exposing the port.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional machine-to-machine API token (Authorization: Bearer <token>).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=

# Secret used to sign short-lived JWT tokens from POST /auth/token.
# Leave empty to fall back to DASHBOARD_PASSWORD (not recommended for production).
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# In-memory rate limiting for the web process. Set RATE_LIMIT_REQUESTS=0 to disable.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable when a trusted reverse proxy sets X-Forwarded-For / X-Real-IP.
TRUST_PROXY_HEADERS=false
# Comma-separated browser origins for a separately hosted frontend.
# Leave empty for the built-in same-origin dashboard.
CORS_ORIGINS=

# Live dashboard refresh cadence (seconds).
SSE_INTERVAL_SECONDS=5

# WebSocket ticker cadence for /ws/prices and the /live page (seconds).
WS_INTERVAL_SECONDS=3
# Lifetime of the short-lived token embedded in the /live page (minutes).
WS_TOKEN_EXPIRY_MINUTES=5

# Automatic retries for scheduled jobs (scan, daily report, backup).
# JOB_MAX_RETRIES counts retries after the first attempt.
JOB_MAX_RETRIES=2
JOB_RETRY_BACKOFF_SECONDS=3.0

# Automatic SQLite backups at 00:15 UTC. Disable for non-SQLite databases.
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=14

# SQLite path. Use forward slashes on Windows.
DATABASE_URL=sqlite:///./data/money_machine.db

# Telegram bot from @BotFather.
TELEGRAM_BOT_TOKEN=
# Send /id to the bot after it starts, then paste the number here.
TELEGRAM_CHAT_ID=
# Bot username (without @) for the Telegram Login Widget. Usually auto-detected.
# Link the dashboard domain to the bot with @BotFather /setdomain first.
TELEGRAM_BOT_USERNAME=

# Google / Gmail OAuth login. Create a Web application OAuth client in the
# Google Cloud console, then add <origin>/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback; defaults to <current origin>/auth/google/callback.
GOOGLE_REDIRECT_URI=

# MEXC USDT-perpetual API. KYC is required for futures trading permission.
# Enable READ + FUTURES TRADE only. NEVER enable withdrawals.
MEXC_API_KEY=
MEXC_SECRET=
MEXC_PASSWORD=

# Master safety switch. Live orders are impossible while this is false.
LIVE_TRADING_ALLOWED=false

# Scanner cadence. 20 seconds is responsive without hammering the API.
SCAN_INTERVAL_SECONDS=20
MARKET_CACHE_SECONDS=15
